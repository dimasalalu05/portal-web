Enum role_type {
 admin
 anggota
}

Table users {
 id int [pk, increment]
 name varchar(255) [not null]
 username varchar(100) [unique, not null]
 email varchar(100) [unique, not null]
 email_verified_at timestamp [null]
 password varchar(100) [ not null]
 remember_token varchar(100) [null]
 role role_type [default: 'anggota', not null]
 created_at timestamp [default: 'now()']
 updated_at timestamp [default: 'now()']
 avatar varchar(100) [null]
 }

// Artikel Utama
Table articles {
 id int [pk, increment]
 title varchar (255) [not null]
 slug varchar(100) [unique, not null]
 content longtext [not null]
 thumbnail varchar(100) [null]
 image_source_url text [null]
 image_license varchar(100) [null]
 author_id int [not null]
 category_id int [not null]
 created_at timestamp [default: 'now()']
 updated_at timestamp [default: 'now()']
 }

 Table channels {
 id int [pk, increment]
 name varchar(100) [not null]
 slug varchar(100) [unique, not null]
 description text [null]
 }

 Table categories {
 id int [pk, increment]
 channel_id int [not null]
 name varchar(100) [not null]
 slug varchar(100) [unique, not null]
 }

 // Sumber Artikel 
 Table article_sources {
 id int [pk, increment]
 article_id int [not null]
 name varchar(255) [not null]
 title varchar(255) [not null]
 url text [not null]
 }

 // RELASI Article
 Ref: articles.author_id > users.id
 Ref: articles.category_id > categories.id
 Ref: categories.channel_id > channels.id
 Ref:article_sources.article_id > articles.id
 